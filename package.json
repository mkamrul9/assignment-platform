{
  "name": "reviewdock",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": "^22.18.0 || ^24.11.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names web,api --prefix-colors cyan,green \"npm run dev --workspace=@reviewdock/web\" \"npm run dev --workspace=@reviewdock/api\"",
    "dev:web": "npm run dev --workspace=@reviewdock/web",
    "dev:api": "npm run dev --workspace=@reviewdock/api",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces && npm run typecheck:tooling",
    "typecheck:tooling": "tsc -p tsconfig.tooling.json",
    "lint": "npm run lint --workspaces && npm run lint:tooling",
    "lint:tooling": "eslint apps/api/tests apps/api/prisma apps/api/prisma.config.ts e2e playwright.config.ts eslint.config.mjs --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose stop postgres",
    "db:generate": "npm run db:generate --workspace=@reviewdock/api",
    "db:migrate": "npm run db:migrate --workspace=@reviewdock/api",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace=@reviewdock/api",
    "db:seed": "npm run db:seed --workspace=@reviewdock/api",
    "db:reset": "npm run db:reset --workspace=@reviewdock/api",
    "db:check": "npm run db:check --workspace=@reviewdock/api",
    "auth:check": "npm run auth:check --workspace=@reviewdock/api",
    "submissions:check": "npm run submissions:check --workspace=@reviewdock/api",
    "reviews:check": "npm run reviews:check --workspace=@reviewdock/api",
    "demo:prepare": "npm run demo:prepare --workspace=@reviewdock/api",
    "demo:seed": "npm run demo:seed --workspace=@reviewdock/api",
    "demo:reset": "npm run demo:reset --workspace=@reviewdock/api",
    "demo:check": "npm run demo:check --workspace=@reviewdock/api",
    "perf:check": "npm run perf:check --workspace=@reviewdock/api",
    "demo:dev": "node scripts/demo-dev.mjs",
    "start:hosted": "node scripts/start-hosted.mjs",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:ui": "npm run build && playwright test --ui"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0"
  }
}
