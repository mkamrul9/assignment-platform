# Server-only address. Browser requests use /api on the web origin.
API_INTERNAL_URL=http://127.0.0.1:4000

# When 1, Next forwards X-Forwarded-For from a trusted ingress that already
# replaced (not appended) the client IP. Leave 0 when Next is the public
# boundary without a verified client address — login/signup limits then share
# the Next→Express peer bucket. Never expose Express publicly in that topology.
# TRUST_INGRESS_CLIENT_IP=0
