# Copy to apps/api/.env.demo for the isolated demo sandbox.
# Never point this file at the development database name `reviewdock`.

DEMO_MODE=1
NODE_ENV=development
PORT=4001

# Same Postgres server as development is fine; the database name must be reviewdock_demo
# or reviewdock_demo_*. Adjust the host port to match your Compose POSTGRES_PORT.
DATABASE_URL=postgresql://reviewdock:reviewdock@127.0.0.1:5432/reviewdock_demo?schema=public

# Demo-only signing secret (not the production/development JWT_SECRET).
JWT_SECRET=demo-only-jwt-secret-replace-me-32chars
JWT_ISSUER=reviewdock
JWT_AUDIENCE=reviewdock-web
WEB_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
TRUST_PROXY=1
SESSION_COOKIE_NAME=reviewdock_session

# Normal mentor seed variables are unused by demo:seed (fixtures are synthetic).
# Keep them out of public docs and never reuse real mentor credentials here.
