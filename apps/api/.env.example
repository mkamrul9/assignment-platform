NODE_ENV=development
PORT=4000

# Matches compose.yaml defaults. Change both together when customizing local Postgres.
DATABASE_URL=postgresql://reviewdock:reviewdock@127.0.0.1:5432/reviewdock?schema=public

# Session signing secret. Generate with: openssl rand -base64 48
# Must be at least 32 characters. Never commit a real secret.
JWT_SECRET=replace-with-a-long-random-secret-value
JWT_ISSUER=reviewdock
JWT_AUDIENCE=reviewdock-web

# Comma-separated browser origins allowed for cookie-authenticated mutations.
WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Trust a single reverse-proxy hop for req.ip (Next.js /api proxy to Express).
# Keep 0 if clients talk to Express directly. The Next proxy strips caller
# X-Forwarded-For by default; set TRUST_INGRESS_CLIENT_IP=1 on the web app only
# when a trusted ingress has already replaced XFF with the verified peer IP.
TRUST_PROXY=1

SESSION_COOKIE_NAME=reviewdock_session

# Required only for `npm run db:seed`. Never commit real credentials.
MENTOR_NAME=ReviewDock Mentor
MENTOR_EMAIL=mentor@example.com
MENTOR_PASSWORD=change-me-now
