{
  "name": "@reviewdock/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prebuild": "prisma generate",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "pretypecheck": "prisma generate",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset",
    "db:check": "tsx tests/persistence.check.ts",
    "auth:check": "tsx tests/auth.check.ts",
    "submissions:check": "tsx tests/submissions.check.ts",
    "reviews:check": "tsx tests/reviews.check.ts",
    "demo:prepare": "tsx prisma/demo-prepare.ts",
    "demo:seed": "tsx prisma/demo-seed.ts",
    "demo:reset": "tsx prisma/demo-reset.ts",
    "demo:check": "tsx tests/demo.check.ts",
    "perf:check": "tsx tests/perf.check.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.0.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.0.0",
    "jose": "^6.2.13",
    "pg": "^8.23.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15"
  }
}
