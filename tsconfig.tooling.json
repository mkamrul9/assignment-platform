{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "apps/api/src/types/**/*.d.ts",
    "e2e/**/*.ts",
    "playwright.config.ts",
    "apps/api/tests/**/*.ts",
    "apps/api/prisma/**/*.ts",
    "apps/api/prisma.config.ts"
  ]
}
